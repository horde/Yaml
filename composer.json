{
    "name": "horde/yaml",
    "description": "Roundtrip-capable YAML parsing and writing library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Yaml",
    "license": "BSD-2-Clause",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "lead"
        },
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Mike Naberezny",
            "email": "mike@maintainable.com",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "lossless",
        "roundtrip",
        "compliant"
    ],
    "time": "2026-07-04",
    "repositories": [],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*"
    },
    "require-dev": {
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Yaml": "lib/"
        },
        "psr-4": {
            "Horde\\Yaml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Yaml\\Test\\": "test/",
            "Horde\\Yaml\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}